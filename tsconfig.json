{
    "compilerOptions": {
        "rootDir": "./",
        "outDir": "./dist",
        "module": "esnext",
        "target": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "allowSyntheticDefaultImports": true,
        "paths": {
            "h2": ["./ext-h2/http2.d.ts"]
        },
        "typeRoots": [],
        "lib": [
            "esnext"
        ],
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": false,
        "jsx": "react-jsx",
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "moduleDetection": "force",
        "skipLibCheck": true,
        "allowJs": true
    },
    "include": [
        "src/**/*",
        "ext-h2/**/*.d.ts",
        "types/**/*.d.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "deps/**/*"
    ]
}
